# ============================================================================
# VISIONFLIX – PERSONAL NETFLIX MANAGEMENT ENVIRONMENT CONFIGURATION
# ============================================================================

# 1. Supabase Credentials (from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 3. Google Cloud OAuth 2.0 Credentials (for Gmail Notification Sync)
# Scope required: https://www.googleapis.com/auth/gmail.readonly
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# 4. Officially Authorized Provider Credentials (Optional)
# If an official partner agreement is established, supply credentials below.
# Otherwise, VisionFlix operates in standard manual support & diagnostic guidance mode.
OFFICIAL_NETFLIX_PARTNER_API_KEY=
OFFICIAL_NETFLIX_PARTNER_SECRET=
